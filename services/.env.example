# Copy to .env before `docker compose up`:  cp .env.example .env
# .env is gitignored. These values move to SSM Parameter Store in AWS.

# Database superuser, created on first start. Used for administration only.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root

# Least-privileged user the backend connects with (readWrite on MONGO_DB only).
MONGO_APP_USERNAME=app
MONGO_APP_PASSWORD=change-me-app

# Application database name.
MONGO_DB=appdb
