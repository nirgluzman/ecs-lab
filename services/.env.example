# Copy to .env before `docker compose up`:  cp .env.example .env
# .env is gitignored. The credentials below move to SSM Parameter Store in AWS;
# the image settings move into the ECS task definition.

# --- Images ---
# Compose builds <IMAGE_PREFIX>/<service>:<IMAGE_TAG>, which is exactly an ECR
# image URI: <registry>/<repository>:<tag>. "ecs-lab/backend" is a valid ECR
# repository name, so only the registry part changes between local and AWS.
#
# Local default. To push to ECR instead, authenticate and set the full registry:
#   aws ecr get-login-password --region <region> \
#     | docker login --username AWS --password-stdin \
#         <account>.dkr.ecr.<region>.amazonaws.com
#   IMAGE_PREFIX=<account>.dkr.ecr.<region>.amazonaws.com/ecs-lab
IMAGE_PREFIX=ecs-lab

# Prefer an immutable tag (a git SHA) for anything ECS pulls: a task definition
# pinned to a mutable tag like "dev" will not reliably pick up a new push.
IMAGE_TAG=dev

# --- MongoDB ---
# Database superuser, created on first start. Used for administration only.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root

# Least-privileged user the backend connects with (readWrite on MONGO_DB only).
MONGO_APP_USERNAME=app
MONGO_APP_PASSWORD=change-me-app

# Application database name.
MONGO_DB=appdb
