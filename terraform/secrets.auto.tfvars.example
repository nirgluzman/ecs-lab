# Copy to secrets.auto.tfvars, then edit:  cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# *.tfvars is gitignored, and *.auto.tfvars is loaded on every plan and apply
# with no -var-file flag. Both variables are ephemeral, so the values are
# written to SSM and to nothing else - not terraform.tfstate, not a saved plan.
#
# Match the values in services/.env so the local stack and AWS agree.
# After changing either one, bump mongo_secret_version to push the new value.

mongo_root_password = "change-me-root"
mongo_app_password  = "change-me-app"

# mongo_secret_version = 1
