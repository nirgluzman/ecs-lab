# --- Claude Code ---
# Local settings hold secrets (e.g. CONTEXT7_API_KEY). Never commit.
.claude/settings.local.json
.claude/*.local.json

# --- Terraform ---
# Provider/module downloads and lock-agnostic dirs
**/.terraform/*

# State: may contain secrets in plaintext; use remote backend
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files: commonly hold credentials
*.tfvars
*.tfvars.json

# --- Python ---
# uv creates .venv next to each pyproject.toml (see services/*/README.md).
__pycache__/
*.py[cod]
.venv/

# --- Secrets / env ---
.env
.env.*
# ...but the placeholder template is meant to be committed
!.env.example
